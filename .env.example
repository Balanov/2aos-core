A2OS_HOST=127.0.0.1
A2OS_PORT=8787
A2OS_DATA_DIR=.2aos
A2OS_WORKERS=4
A2OS_LOG_LEVEL=info
# Base64-encoded 32 bytes. Without it a local key is generated in A2OS_DATA_DIR.
A2OS_MASTER_KEY=
# Optional fixed bootstrap key. Otherwise a random key is printed once.
A2OS_ADMIN_KEY=
A2OS_MODEL_ENABLED=false
A2OS_MODEL_KIND=ollama
A2OS_MODEL_URL=http://127.0.0.1:11434
A2OS_MODEL_NAME=qwen3:4b
A2OS_VISION_MODEL=
# Comma-separated origins, never full secrets or URLs with credentials.
A2OS_ALLOWED_ENDPOINTS=http://127.0.0.1:11434,http://localhost:11434
A2OS_DEVELOPMENT_PACKAGES=true
# Base64 DER SPKI key. Required for signed production registry packages.
A2OS_REGISTRY_PUBLIC_KEY=
A2OS_EXPORT_MIN_TENANTS=5
